# ——— FLAMINGO AUTO KÉNITRA — variables d'environnement ———
# Copiez ce fichier vers `.env.local` et complétez.
# Aucune variable n'est obligatoire : sans Supabase, le site fonctionne
# en mode « base locale JSON » (data/db.json) avec le compte admin local.

# Mode de base locale (facultatif)
ADMIN_PASSWORD=flamingo2026
ADMIN_SECRET=changez-cette-cle-secrete-jwt
NEXT_PUBLIC_ADMIN_HINT=flamingo2026

# Mode Supabase (recommandé en production — auth, storage, RLS)
# Renseignez ces 3 variables pour basculer automatiquement sur Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
